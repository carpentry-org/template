(load "my-mod.carp")

; the title also names the generated index page (my-project_index.html),
; so keep it short and free of spaces
(Project.config "title" "my-project")
(Project.config "docs-directory" "./docs/")
(Project.config "docs-logo" "")
(Project.config "docs-url" "https://github.com/your-user/your-project")
(Project.config "docs-styling" "style.css")

; with a single module, its own page is the landing page and no index is
; worth generating; uncomment this once that is true for your project
; (Project.config "docs-generate-index" false)

(Project.config "docs-prelude" "This is my awesome project, and this
is going on the *front page*!

Example:
```
I can write markdown here!
```
")
(save-docs MyMod)

(quit)
